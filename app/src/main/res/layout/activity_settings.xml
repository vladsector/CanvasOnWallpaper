<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video Canvas"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:strokeWidth="0dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable Canvas"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:layout_centerVertical="true" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/canvasEnabledSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="12dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transition Blur"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:layout_centerVertical="true" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/blurSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transition Intensity" android:textColor="@color/on_surface_variant" android:textSize="14sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/blurSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:stepSize="0.05"
                    app:thumbColor="@color/spotify_green"
                    app:trackColorActive="@color/spotify_green" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video Brightness" android:textColor="@color/on_surface_variant" android:textSize="14sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/brightnessSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:stepSize="0.05"
                    app:thumbColor="@color/spotify_green"
                    app:trackColorActive="@color/spotify_green" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Album Art Fallback"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:strokeWidth="0dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable Album Art"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:layout_centerVertical="true" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/albumArtEnabledSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Image Blur" android:textColor="@color/on_surface_variant" android:textSize="14sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/imageBlurSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="5.0"
                    android:stepSize="0.1"
                    app:thumbColor="@color/spotify_green"
                    app:trackColorActive="@color/spotify_green" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Image Brightness" android:textColor="@color/on_surface_variant" android:textSize="14sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/imageBrightnessSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:stepSize="0.05"
                    app:thumbColor="@color/spotify_green"
                    app:trackColorActive="@color/spotify_green" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Idle Background"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable Custom Wallpaper"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:layout_centerVertical="true" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/idleEnabledSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectCustomWallpaperBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Custom Wallpaper"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/spotify_green"
                    android:textColor="@color/white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
